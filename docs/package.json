{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm build:registry && pnpm build:content && vite dev",
		"build": "pnpm build:registry && pnpm build:content && wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"build:registry": "tsx scripts/build-registry.ts build-registry",
		"build:content": "velite",
		"check": "pnpm build:registry && pnpm build:content && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify/svelte": "^5.2.2",
		"@internationalized/date": "^3.12.3",
		"@playwright/test": "^1.62.1",
		"@prettier/sync": "0.6.1",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^3.23.0",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@vitest/browser-playwright": "^4.1.11",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"acorn": "^8.18.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"embla-carousel-svelte": "^8.6.0",
		"estree-walker": "^3.0.3",
		"lily-svelte": "workspace:*",
		"magic-string": "^1.2.2",
		"mdsx": "^0.0.7",
		"package-manager-detector": "^1.8.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.62.1",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-pretty-code": "^0.14.5",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.4.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"svelte-tel-input": "^4.3.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"unist-builder": "^4.0.0",
		"unist-util-visit": "^5.1.0",
		"velite": "^0.3.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@tanstack/table-core": "^8.21.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.1",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte-easy-crop": "^5.0.1",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^2.30.2",
		"vaul-svelte": "1.0.0-next.7"
	}
}
