{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "./worker-configuration.d.ts"]
	},
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
	"exclude": ["node_modules/**", "src/service-worker"]
}
